# Local development. Production settings live in Render (see render.yaml and docs/DEPLOY.md); with PRAISE_ENV=production
# the API refuses to start on any of the development values below.
SECRET_KEY=change-me
# Local PostgreSQL, or Supabase's session pooler (port 5432) ending in ?sslmode=require to run migrations against it.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/praise
GEMINI_API_KEY=
# AI_MODE=mock   # offline keyword classifier for dev; leave unset in production
AI_DAILY_BUDGET=500
GEMINI_MODEL=gemini-3.8-flash
DASHBOARD_ORIGIN=http://localhost:5500
API_ORIGIN=http://localhost:5000

# Optional: Google sign-in. A Google Cloud OAuth "Web application" client whose redirect URIs include
# http://localhost:5000/api/auth/google/callback (and the production one, see docs/DEPLOY.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: let a local model (Ollama) reword the buddies' lines and answer open questions in their chat. Off by default; the written lines always work.
COMPANION_LLM=
OLLAMA_URL=http://localhost:11434
COMPANION_MODEL=qwen2.5:3b-instruct

# Several workers: count login/pairing limits and the AI daily budget in the database (table rate_counters, run flask db upgrade). 1 = on.
RATELIMIT_SHARED=
# Seconds another worker may serve an older copy of a policy after an edit (this process sees edits at once).
POLICY_CACHE_TTL=10
